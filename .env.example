# El frontend usa estas rutas relativas y Vite las reenvía a los microservicios.
VITE_API_USUARIOS_URL=/api/usuarios
VITE_API_PRODUCTOS_URL=/api/productos
VITE_API_VENTAS_URL=/api/ventas

# Direcciones locales por defecto del docker-compose del backend.
VITE_BACKEND_USUARIOS_URL=http://localhost:8081
VITE_BACKEND_PRODUCTOS_URL=http://localhost:8082
VITE_BACKEND_VENTAS_URL=http://localhost:8083
